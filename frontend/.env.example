# SHARD — frontend build-time configuration.
# Copy to `.env.local` (git-ignored) and adjust. Every variable is optional:
# with none of them set the client is same-origin, which is what the
# single-container Docker image serves.

# Relay REST base (room creation, room probe).
# Set this ONLY when the static bundle is hosted apart from the Go relay.
# This must be the RELAY's host, never the site's: pointing it at
# https://shardchat.onrender.com would POST /api/rooms to the static site,
# which serves no API, and every room creation would fail with a 404.
# VITE_API_BASE=https://shardchat-backend.onrender.com

# Relay WebSocket base (the session rendezvous socket).
# Must be ws:// or wss:// — wss:// is mandatory on an https page.
# Same rule as above: the relay host, not the site host.
# VITE_WS_URL=wss://shardchat-backend.onrender.com

# shard-media SFU node (call signaling + media), deployed from shard-media/.
# Unset → the page's own origin with a scheme derived from the protocol
# (wss: on https). Point at the media node's host when it is deployed
# as a separate Render service.
# VITE_MEDIA_URL=wss://shard-media.onrender.com

# Call transport strategy.
#   p2p (default) — direct WebRTC between the two participants; SDP/ICE ride
#     the room relay socket, ICE servers come from the relay's
#     /api/webrtc-config (OpenRelay TURN fallback on hard NATs/mobile).
#   sfu — media flows through the shard-media node (VITE_MEDIA_URL).
# With VITE_MEDIA_URL set and this variable unset, sfu is assumed.
VITE_CALL_TRANSPORT=p2p

# When VITE_API_BASE / VITE_WS_URL / VITE_MEDIA_URL point at other origins,
# those origins' services must accept the frontend origin (the relay's
# ALLOWED_ORIGINS; the SFU accepts any origin by design).
