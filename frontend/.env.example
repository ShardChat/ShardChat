# SHARD — frontend build-time configuration.
# Copy to `.env.local` (git-ignored) and adjust. Every variable is optional:
# with none of them set the client is same-origin, which is what the
# single-container Docker image serves.

# Relay REST base (room creation, room probe, TURN credentials).
# Set this ONLY when the static bundle is hosted apart from the Go relay.
# This must be the RELAY's host, never the site's: pointing it at
# https://shardchat.onrender.com would POST /api/rooms to the static site,
# which serves no API, and every room creation would fail with a 404.
# VITE_API_BASE=https://shardchat-backend.onrender.com

# Relay WebSocket base (the session rendezvous socket).
# Must be ws:// or wss:// — wss:// is mandatory on an https page.
# Same rule as above: the relay host, not the site host.
# VITE_WS_URL=wss://shardchat-backend.onrender.com

# STUN server used when the relay serves no TURN credentials.
# Defaults to stun:stun.cloudflare.com:3478.
# VITE_STUN_URL=stun:stun.example.com:3478

# When VITE_API_BASE / VITE_WS_URL point at another origin, that frontend
# origin must also be listed in the relay's ALLOWED_ORIGINS environment
# variable, otherwise the CORS middleware and the WebSocket origin check
# reject it with 403.
